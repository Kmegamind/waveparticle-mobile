# Environment variable NAMES this project reads, with placeholder values only.
# Copy to .env (git-ignored) for local values; set real values in the deploy platform or CI secrets.
# Read by src/lib/supabase. Use the public (anon or publishable) key only. Never put a service-role key in the app code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only names read by src/lib/model-gateway/server.ts. Do not expose them to the browser.
# The provider is not chosen. Point MODEL_API_URL at a chat-completions endpoint when one is approved.
# If any of the three is missing, the gateway returns an authored line and does not call the network.
MODEL_API_KEY=your-model-api-key
MODEL_API_URL=https://example.invalid/v1/chat/completions
MODEL_NAME=your-model-name
# Server-only reader token for the prompts table (#282, docs/ai/prompts/README.md). Never NEXT_PUBLIC_.
PROMPTS_READ_TOKEN=your-prompts-read-token
# Server-only reader key for the story content (#284, docs/decisions/0019). Never NEXT_PUBLIC_.
# Make one with: node scripts/content/token.mjs
CONTENT_READ_KEY=your-content-read-key
# Used only by the generation benchmark (issue #130), server side and local. Never in browser code.
DEEPSEEK_API_KEY=your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key

# Signs the goal dialogue's turns (#31, docs/decisions/0026). Server only, at least 32 characters.
# Required in production: without it every turn is refused (the page shows GD-F).
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOAL_DIALOGUE_SECRET=

# Per-browser daily limit of 20 real model calls on /goal and /try (#256, docs/deploy.md). Server only.
# Unset or 1: the limit is on. 0: the limit is off (the test stage). Any other value keeps it on and logs one warning.
MODEL_CALL_LIMIT_ENABLED=1

# The prompt lab's model prices (#476, docs/api/ai-runs.md). Server only, never NEXT_PUBLIC_.
# JSON: {"<MODEL_NAME>": {"input_usd_per_million_tokens": <US dollars>, "output_usd_per_million_tokens": <US dollars>}}
# Set by the owner from the provider's price list. Unset: every run's cost is null ("price not set").
AI_RUN_PRICES=

# The research flag (#114, docs/deploy.md, Research flag). Server only. Set to 1 before the first
# participant is assigned: a missing research_condition() then keeps the focus page from opening.
# Unset: a missing function reads as "not in the study" (one warning per server process).
RESEARCH_STUDY_ACTIVE=
