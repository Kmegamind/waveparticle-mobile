{
  "name": "waveparticle-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:index": "node scripts/docs-index.mjs",
    "check:cards": "vitest run tests/seed-card-checks.test.ts",
    "test": "vitest run && python3 -I tests/test_guardrails.py",
    "test:e2e": "playwright test",
    "check:supabase": "node --env-file=.env scripts/check-supabase.mjs",
    "check:providers": "node --env-file=.env scripts/check-providers.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:pr": "node scripts/check-pr.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
